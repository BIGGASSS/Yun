{
	email {$ACME_EMAIL}
	http_port 8080
	https_port 8443
	admin off
	servers {
		timeouts {
			read_header 10s
			read_body 60s
			write 5m
			idle 2m
		}
	}
}

{$YUN_DOMAIN} {
	header Strict-Transport-Security "max-age=31536000"
	request_body {
		max_size 12MB
	}
	# No caching and no header rewriting: preserve auth and range/upload headers.
	reverse_proxy server:8080
}
